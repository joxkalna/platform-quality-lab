{
  "thresholds": {
    "http_req_failed": ["rate<0.05"],
    "checks": ["rate>0.90"],
    "http_req_duration": ["p(95)<3000"],
    "browser_classify_duration": ["p(95)<30000"],
    "browser_page_load_duration": ["p(95)<5000"]
  },
  "scenarios": {
    "http-backend-load": {
      "exec": "dataFlow",
      "executor": "constant-arrival-rate",
      "rate": 3,
      "timeUnit": "1s",
      "preAllocatedVUs": 5,
      "maxVUs": 15,
      "duration": "1m"
    },
    "browser-classify": {
      "exec": "classifyBrowser",
      "executor": "constant-vus",
      "vus": 2,
      "duration": "1m",
      "options": {
        "browser": {
          "type": "chromium"
        }
      }
    }
  }
}
